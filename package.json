{
  "name": "kobitokey-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:browser-firmware": "node scripts/run-browser-firmware-check.mjs",
    "check:browser-firmware:ui": "node scripts/check-browser-firmware-ui-smoke.mjs",
    "check:browser-firmware:evidence-self-test": "node scripts/check-browser-firmware-evidence-self-test.mjs",
    "check:browser-firmware:collector-self-test": "node scripts/check-browser-firmware-collector-self-test.mjs",
    "check:browser-firmware:e2e-report": "node scripts/check-browser-firmware-external-evidence.mjs",
    "check:browser-firmware:merge-readiness": "node scripts/check-browser-firmware-merge-readiness.mjs",
    "check:browser-firmware:merge-readiness-self-test": "node scripts/check-browser-firmware-merge-readiness-self-test.mjs",
    "check:browser-firmware:production-preflight": "node scripts/check-browser-firmware-production-preflight.mjs",
    "check:browser-firmware:production-release-preflight": "node scripts/check-browser-firmware-production-preflight.mjs --require-oauth",
    "check:browser-firmware:public-release": "node scripts/check-browser-firmware-public-release.mjs",
    "check:browser-firmware:release-status": "node scripts/check-browser-firmware-release-status.mjs",
    "check:browser-firmware:public-release-self-test": "node scripts/check-browser-firmware-public-release-self-test.mjs",
    "check:browser-firmware:production-preflight-self-test": "node scripts/check-browser-firmware-production-preflight-self-test.mjs",
    "collect:browser-firmware:e2e-report": "node scripts/collect-browser-firmware-e2e-evidence.mjs",
    "deploy:browser-firmware": "node scripts/deploy-browser-firmware-production.mjs",
    "preview": "npm run build && wrangler dev",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run deploy:browser-firmware -- --require-oauth"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@zmkfirmware/zmk-studio-ts-client": "^0.0.18",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@tauri-apps/cli": "^2.11.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright-core": "^1.60.0",
    "run-script-os": "^1.1.6",
    "typescript": "^5.6.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  }
}

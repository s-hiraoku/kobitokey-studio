{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kobitokey-studio",
  "compatibility_date": "2026-05-17",
  "main": "./src/worker.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "kobito-key-studio.hiraoku.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KobitoKey Studio",
  "version": "0.1.0",
  "identifier": "com.s-hiraoku.kobitokey-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KobitoKey Studio",
        "width": 1920,
        "height": 1160,
        "minWidth": 1520,
        "minHeight": 920
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
